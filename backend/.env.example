# Copy to `.env` in this directory (gitignored) and fill in values, or export these in your shell.
# Uvicorn does not load `.env` automatically — use `docker compose` (see repo root) or export before `uv run uvicorn`.

# GitHub PAT with `repo` scope — required for AI metrics API routes unless you skip validation below.
GITHUB_TOKEN=

# Repository to query for metrics (`owner/name`, e.g. `acme/my-repo`).
GITHUB_REPO=

# Set to `1` for local work when you only need `/health` and are not calling GitHub-backed endpoints.
# Do not use in production.
SKIP_ENV_VALIDATION=
