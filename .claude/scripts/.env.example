# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
#
# Load before running scripts:
#   source .env && uv run python .claude/scripts/smoke_test.py
# Or install direnv (https://direnv.net/) and rename to .envrc for auto-loading.

# ---------------------------------------------------------------------------
# LLM Provider — choose exactly ONE provider mode
# ---------------------------------------------------------------------------

# --- Option A: Direct Anthropic API ---
# LLM_PROVIDER=direct
# LLM_API_KEY=sk-ant-...

# --- Option B: Anthropic-compatible gateway (e.g. LiteLLM) ---
# LLM_PROVIDER=gateway
# LLM_API_KEY=...
# LLM_BASE_URL=https://your-gateway.example.com
# Keep model IDs in AI_PIPELINE_CONFIG.json as anthropic.claude-*

# --- Option C: AWS Bedrock ---
LLM_PROVIDER=bedrock
AWS_DEFAULT_REGION=us-west-2
# Choose ONE credential method:
# AWS_PROFILE=your-sso-profile      # SSO / named profile (preferred)
# AWS_ACCESS_KEY_ID=...             # static key
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...             # required for temporary/SSO creds

# ---------------------------------------------------------------------------
# GitHub (only needed when running scripts against a real repo, not --dry-run)
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_...
